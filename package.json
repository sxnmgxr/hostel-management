{
  "name": "hostel-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:users": "tsx --env-file=.env scripts/migrate-users.ts",
    "db:migrate:fees": "tsx --env-file=.env scripts/migrate-fees.ts",
    "db:migrate:students": "tsx --env-file=.env scripts/migrate-students.ts",
    "db:migrate:expenses": "tsx --env-file=.env scripts/migrate-expenses.ts",
    "db:migrate:communications": "tsx --env-file=.env scripts/migrate-communications.ts",
    "db:migrate:attendance": "tsx --env-file=.env scripts/migrate-attendance.ts",
    "db:migrate:calendar": "tsx --env-file=.env scripts/migrate-calendar.ts",
    "db:migrate:academic": "tsx --env-file=.env scripts/migrate-academic.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^8.0.0-rc.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
